# Catalog Audit - environment configuration
# Copy this file to .env and fill in your keys.

# Discogs personal access token. Get one free at:
#   https://www.discogs.com/settings/developers  ->  "Generate new token"
DISCOGS_TOKEN=

# Groq API key for AI verdicts (free tier, no credit card).
# Get one at: https://console.groq.com/keys
# If empty, the app falls back to a rule-based verdict.
GROQ_API_KEY=

# Optional: Google Gemini key as a second AI fallback.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: change the local server port (default 5000)
PORT=5000
