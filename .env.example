# Catalog Audit - environment overrides (OPTIONAL)
#
# The recommended way to set API keys is the "API KEYS" card in the web
# UI at http://127.0.0.1:5000. Keys you save there are stored locally at
# ~/.catalog_audit/keys.json (mode 0600) and never enter the repo.
#
# This file is only useful if you want to override / pre-seed values via
# the environment, for example in a CI runner or a shared dev box. If
# any of these env vars are set AND no key is saved in the UI for the
# same field, the env value is used.
#
# To use:
#   1. cp .env.example .env
#   2. paste your real values below
#   3. .env is gitignored, so it never leaves your machine
#
# Leave blank or delete a line to fall through to the UI store.

DISCOGS_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=

# Where audit results land. Defaults to ./Outputs next to run.py.
OUTPUT_DIR=
