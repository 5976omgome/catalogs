# Copy this file to .env and fill in your keys.
# .env is gitignored and never committed.

# Discogs personal access token (free, no card)
# Get one at: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Groq API key (free, no card) - powers the AI label-bridge
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API key (free) - fallback for the AI bridge
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Output folder (default: ./Outputs)
OUTPUT_DIR=
